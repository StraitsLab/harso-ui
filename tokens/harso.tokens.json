    "jade": { "light": { "accent": "#01795b", "accent-mark": "#309878", "accent-soft": "#e2f0ea" }, "dark": { "accent": "#52b694", "accent-mark": "#118565", "accent-soft": "#283e3b" } },
    "ruby": { "light": { "accent": "#b33c5c", "accent-mark": "#d9607c", "accent-soft": "#f9e3e6" }, "dark": { "accent": "#f27692", "accent-mark": "#c34b6a", "accent-soft": "#462d36" } },
    "amber": { "light": { "accent": "#a35801", "accent-mark": "#c77323", "accent-soft": "#fbece1" }, "dark": { "accent": "#ea9449", "accent-mark": "#b16001", "accent-soft": "#49392f" } },
    "citrine": { "light": { "accent": "#7d6b05", "accent-mark": "#9e8706", "accent-soft": "#f6f2e2" }, "dark": { "accent": "#c6ad2f", "accent-mark": "#877406", "accent-soft": "#43412f" } },
    "lagoon": { "light": { "accent": "#077586", "accent-mark": "#1195aa", "accent-soft": "#e1f0f4" }, "dark": { "accent": "#41b4c9", "accent-mark": "#088193", "accent-soft": "#263e47" } },
    "blue": { "light": { "accent": "#2e67b5", "accent-mark": "#4f89da", "accent-soft": "#e0eaf8" }, "dark": { "accent": "#65a1f3", "accent-mark": "#3b75c4", "accent-soft": "#27364c" } },
    "violet": { "light": { "accent": "#824fb6", "accent-mark": "#a370da", "accent-soft": "#ede6f8" }, "dark": { "accent": "#bb88f3", "accent-mark": "#905dc4", "accent-soft": "#39314b" } }
  },
  "shadow": {
    "$description": "Raised and floating surfaces (CSS only).",
    "shadow": { "light": "0 14px 40px rgb(20 24 32 / .07), 0 1px 2px rgb(20 24 32 / .04)", "dark": "0 14px 40px rgb(0 0 0 / .35), 0 1px 2px rgb(0 0 0 / .3)", "cozy": "0 14px 40px rgb(20 24 32 / .07), 0 1px 2px rgb(20 24 32 / .04)", "darkCozy": "0 14px 40px rgb(0 0 0 / .35), 0 1px 2px rgb(0 0 0 / .3)" },
    "shadow-float": { "light": "0 6px 24px rgb(20 24 32 / .10)", "dark": "0 6px 24px rgb(0 0 0 / .40)", "cozy": "0 6px 24px rgb(20 24 32 / .10)", "darkCozy": "0 6px 24px rgb(0 0 0 / .40)" }
  },
  "font": {
    "$description": "The kit is the one font authority: Instrument Sans for the interface, Geist Mono for evidence (CSS only; theme.css imports both faces).",
    "font": "\"Instrument Sans Variable\", sans-serif",
    "mono": "\"Geist Mono Variable\", ui-monospace, monospace"
  },
  "type": {
    "$description": "Boundaryless v3 type scale (design/DIRECTION.md rule 4): 11 caps · 12 meta · 13 chrome · 14 body · 15 title · 22 display.",
    "text-caps": "11px",
    "text-meta": "12px",
    "text-chrome": "13px",
    "text-body": "14px",
    "text-title": "15px",
    "text-display": "22px",
    "caps-tracking": ".06em"
  },
  "radius": {
    "$description": "v3 radius system (rule 5): 8 rows/buttons · 12 cards · 16 composer/bubbles · pill.",
    "radius-row": "8px",
    "radius-control": "8px",
    "radius-card": "12px",
    "radius-composer": "16px",
    "radius-pill": "999px"
  },
  "indicator": {
    "$description": "v3 indicators (rule 3) and icon stroke (rule 6) (CSS only).",
    "dot": "5px",
    "ring": "16px",
    "stroke": "1.5"
  },
  "space": {
    "$description": "Spacing steps on a 4px grid.",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-6": "24px",
    "space-8": "32px",
    "space-12": "48px",
    "space-16": "64px"
  },
  "motion": {
    "$description": "Motion (CSS only; reduced motion zeroes the durations in theme.css).",
    "fast": "120ms",
    "reveal": "240ms",
    "ease": "cubic-bezier(.2, .7, .2, 1)"
  },
  "alias": {
    "$description": "Legacy names kept so consumers keep compiling; new code uses the v3 names (CSS only). Borderless: surfaces separate by tonal step; the only stroke token left is the inset list hairline.",
    "dark": "{ink}",
    "hairline": "{line}",
    "text-xs": "{text-meta}",
    "text-sm": "{text-chrome}",
    "text-label": "{text-chrome}",
    "text-base": "{text-body}",
    "text-md": "{text-body}",
    "text-input": "{text-body}",
    "text-user": "{text-body}",
    "text-heading": "{text-display}"
  }
}
