{
  "$description": "Harso design values: the one source. scripts/gen-tokens.mjs writes the token blocks of src/theme.css and tokens/generated/HarsoTokens.swift and HarsoTokens.kt from this file; edit here, then run npm run tokens. Keys are the CSS name after --hk-. A value is one string for every appearance, or all four appearances spelled out. Colour values are #rrggbb, rgb(r g b / a), {role} (another role), or {role} / n% (that role at n% opacity).",
  "appearances": ["light", "dark", "cozy", "darkCozy"],
  "color": {
    "$description": "Boundaryless tokens, derived from the approved concept rendering (codex generated_images/01a06fa5…/call_PHmmdfdu3TmtaQuMw1I0ySuK.png). Dark tertiary is >=4.5:1 on the 8% active tint (Axe: the desktop Work row reads its meta on the selected tint). Fields and the active row are one tonal step of ink below whatever they sit on.",
    "canvas": { "light": "#fafafb", "dark": "#131518", "cozy": "#fbf9f5", "darkCozy": "#1a1815" },
    "canvas-deep": { "light": "#f2f4f8", "dark": "#0e1013", "cozy": "#f4f0e8", "darkCozy": "#141210" },
    "panel": { "light": "#f4f5f7", "dark": "#17191d", "cozy": "#f5f2ec", "darkCozy": "#1e1c18" },
    "surface": { "light": "#ffffff", "dark": "#1c1f24", "cozy": "#fffefb", "darkCozy": "#232019" },
    "hover": { "light": "#eef0f3", "dark": "#262a31", "cozy": "#efebe4", "darkCozy": "#2e2a23" },
    "ink": { "light": "#1f2226", "dark": "#f2f3f5", "cozy": "#2a2622", "darkCozy": "#f3ede3" },
    "secondary": { "light": "#5b6067", "dark": "#a5aab3", "cozy": "#66605a", "darkCozy": "#b3aa9c" },
    "tertiary": { "light": "#646a73", "dark": "#979da6", "cozy": "#68625b", "darkCozy": "#a2998c" },
    "faint": { "light": "#a9aeb5", "dark": "#666c76", "cozy": "#b3aca3", "darkCozy": "#6f675c" },
    "line": { "light": "#e6e8ec", "dark": "#262a30", "cozy": "#e8e3db", "darkCozy": "#2e2a24" },
    "line-strong": { "light": "#d6d9df", "dark": "#343941", "cozy": "#d9d3c9", "darkCozy": "#3b362e" },
    "control-line": { "light": "{ink} / 32%", "dark": "{ink} / 40%", "cozy": "{ink} / 32%", "darkCozy": "{ink} / 40%" },
    "accent": { "light": "#1d63c8", "dark": "#6ea8ff", "cozy": "#2f6e53", "darkCozy": "#8fcbaf" },
    "accent-mark": { "light": "#3d8bf5", "dark": "#6ea8ff", "cozy": "#3f8a6a", "darkCozy": "#8fcbaf" },
    "accent-soft": { "light": "#dce8fb", "dark": "#1f2f47", "cozy": "#dcefe5", "darkCozy": "#223a30" },
    "positive": { "light": "#206636", "dark": "#6cc78a", "cozy": "#206636", "darkCozy": "#6cc78a" },
    "positive-mark": { "light": "#3f9a5c", "dark": "#6cc78a", "cozy": "#3f9a5c", "darkCozy": "#6cc78a" },
    "attention": { "light": "#9a5b00", "dark": "#f4b95f", "cozy": "#9a5b00", "darkCozy": "#f4b95f" },
    "attention-mark": { "light": "#f0a23a", "dark": "#f4b95f", "cozy": "#f0a23a", "darkCozy": "#f4b95f" },
    "negative": { "light": "#b93427", "dark": "#ff7b73", "cozy": "#b93427", "darkCozy": "#ff7b73" },
    "negative-mark": { "light": "#d4483f", "dark": "#ff7b73", "cozy": "#d4483f", "darkCozy": "#ff7b73" },
    "inverse": { "light": "#ffffff", "dark": "#131518", "cozy": "#ffffff", "darkCozy": "#1a1815" },
    "glass": { "light": "rgb(255 255 255 / .92)", "dark": "rgb(28 31 36 / .92)", "cozy": "rgb(255 254 251 / .92)", "darkCozy": "rgb(35 32 25 / .92)" },
    "field-tint": { "light": "{ink} / 5%", "dark": "{ink} / 8%", "cozy": "{ink} / 5%", "darkCozy": "{ink} / 8%" },
    "field-tint-hover": { "light": "{ink} / 8%", "dark": "{ink} / 12%", "cozy": "{ink} / 8%", "darkCozy": "{ink} / 12%" },
    "active-tint": { "light": "{ink} / 5%", "dark": "{ink} / 8%", "cozy": "{ink} / 5%", "darkCozy": "{ink} / 8%" }
  },
  "tint": {
    "$description": "The eight Sea Glass R12 colourways as the person's tint (Grayscale is the default), the way macOS accent colour works. A tint replaces only accent, accent-mark and accent-soft. Copied from weave-cloud packages/ui/src/tints.css at a6caf1190cb42a5dc1a6d005d698a2117da2911d; the desktop keeps that file for now.",
