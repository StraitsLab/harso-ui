    {
      "id": "data-kpis",
      "vertical": "data",
      "kind": "card",
      "request": "How did the shop do in August?",
      "says": "A strong month; every week beat the one before.",
      "surface": "inline",
      "fresh": false,
      "components": [
        "KPI tiles",
        "Bar chart",
        "Sparkline (as number change)"
      ],
      "rationale": "Two KPIs and a 4-week bar chart; the busiest week is highlighted; filters are a follow-up question.",
      "document": {
        "kind": "output_blocks",
        "major": 1,
        "header": {
          "title": "Shop · August",
          "subtitle": "Shopify · all channels"
        },
        "blocks": [
          {
            "kind": "numbers",
            "items": [
              {
                "value": "S$48,200",
                "label": "Revenue"
              },
              {
                "value": "+12%",
                "label": "vs July"
              }
            ]
          },
          {
            "kind": "visual",
            "visual": {
              "kind": "chart",
              "chart": "bar",
              "unit": "S$k",
              "x_labels": [
                "1–7 Aug",
                "8–14 Aug",
                "15–21 Aug",
                "22–31 Aug"
              ],
              "series": [
                {
                  "label": "Revenue",
                  "values": [
                    "10.4",
                    "11.2",
                    "12.9",
                    "13.7"
                  ]
                }
              ],
              "highlight_index": 3
            }
          }
        ],
        "details": {
          "sources": [
            {
              "label": "Shopify analytics, 1–31 Aug 2026"
            }
          ]
        },
        "fallback_text": "August revenue S$48,200, up 12% on July; weekly revenue rose to S$13.7k in the last week."
      }
    },
