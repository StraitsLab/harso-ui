    {
      "id": "edu-worked-example",
      "vertical": "education",
      "kind": "card",
      "request": "How do I solve 2x + 6 = 14?",
      "says": "x = 4. Here's each step.",
      "surface": "inline",
      "fresh": false,
      "components": [
        "Worked example"
      ],
      "rationale": "Three numbered steps in one section; plain text maths, no rendering engine needed.",
      "document": {
        "kind": "output_blocks",
        "major": 1,
        "header": {
          "title": "Solve 2x + 6 = 14",
          "subtitle": "Linear equation"
        },
        "blocks": [
          {
            "kind": "text",
            "sections": [
              {
                "paragraphs": [
                  "1. Subtract 6 from both sides: 2x = 8.",
                  "2. Divide both sides by 2: x = 4.",
                  "3. Check: 2 × 4 + 6 = 14."
                ]
              }
            ]
          }
        ],
        "fallback_text": "2x + 6 = 14: subtract 6 to get 2x = 8, divide by 2 to get x = 4; check 2 × 4 + 6 = 14."
      }
    },
