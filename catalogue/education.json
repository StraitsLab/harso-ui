      "id": "edu-lesson",
      "vertical": "education",
      "kind": "card",
      "request": "Explain how compound interest works.",
      "says": "Interest earns interest, so growth speeds up over time.",
      "surface": "page",
      "fresh": false,
      "components": [
        "Lesson",
        "Line chart"
      ],
      "rationale": "One line chart shows the curve better than a paragraph; two short sections carry the idea.",
      "document": {
        "kind": "output_blocks",
        "major": 1,
        "header": {
          "title": "Compound interest",
          "subtitle": "S$10,000 at 5% a year"
        },
        "blocks": [
          {
            "kind": "visual",
            "visual": {
              "kind": "chart",
              "chart": "line",
              "unit": "S$k",
              "x_labels": [
                "Yr 0",
                "Yr 10",
                "Yr 20",
                "Yr 30"
              ],
              "series": [
                {
                  "label": "Compound",
                  "values": [
                    "10",
                    "16.3",
                    "26.5",
                    "43.2"
                  ]
                },
                {
                  "label": "Simple",
                  "values": [
                    "10",
                    "15",
                    "20",
                    "25"
                  ]
                }
              ],
              "highlight_index": 3
            }
          },
          {
            "kind": "text",
            "sections": [
              {
                "heading": "The idea",
                "paragraphs": [
                  "Each year's interest is added to the balance, so next year you earn interest on a bigger amount."
                ]
              },
              {
                "heading": "Why time matters",
                "paragraphs": [
                  "The gap between the two lines grows every year. After 30 years compounding gives S$43,200 against S$25,000."
                ]
              }
            ]
          }
        ],
        "details": {
          "assumptions": [
            "Interest compounds once a year; no withdrawals."
          ]
        },
        "fallback_text": "Compound interest: interest is added to the balance, so it earns interest too. S$10,000 at 5% becomes S$43,200 in 30 years, against S$25,000 with simple interest."
      }
    },
