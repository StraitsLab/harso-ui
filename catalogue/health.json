      "id": "health-symptom",
      "vertical": "health",
      "kind": "card",
      "request": "I've had chest tightness and a sweaty feeling for 20 minutes.",
      "says": "Those can be signs of a heart attack.",
      "surface": "inline",
      "fresh": false,
      "components": [
        "Symptom check with disclaimer"
      ],
      "rationale": "Urgent care is the content, never a disclaimer: status needs-attention cannot stand alone, so the summary carries it untruncated.",
      "document": {
        "kind": "output_blocks",
        "major": 1,
        "header": {
          "title": "Call 995 now",
          "subtitle": "Chest tightness with sweating · 20 minutes"
        },
        "blocks": [
          {
            "kind": "text",
            "summary": "Call 995 for an ambulance now. Don't drive yourself, and stay on the line with the operator.",
            "sections": [
              {
                "bullets": [
                  "Stop what you're doing and sit down.",
                  "If a doctor has said aspirin is safe for you, chew one 300 mg tablet.",
                  "Unlock your door so help can get in."
                ]
              }
            ]
          }
        ],
        "details": {
          "sources": [
            {
              "label": "Singapore Heart Foundation",
              "url": "https://www.myheart.org.sg/"
            }
          ],
          "disclaimers": [
            "Harso is not a doctor. In an emergency always call 995."
          ]
        },
        "fallback_text": "Chest tightness with sweating for 20 minutes can be a heart attack. Call 995 now, sit down, chew one 300 mg aspirin if a doctor has said it is safe for you, unlock your door."
      },
