    {
      "id": "food-recipe",
      "vertical": "food",
      "kind": "card",
      "request": "Give me an easy chicken rice recipe for 4.",
      "says": "This one takes about an hour, mostly hands-off.",
      "surface": "page",
      "fresh": false,
      "components": [
        "Recipe"
      ],
      "rationale": "Time and servings as numbers, then ingredients and method as sections; a photo is optional, not required.",
      "document": {
        "kind": "output_blocks",
        "major": 1,
        "header": {
          "title": "Hainanese chicken rice",
          "subtitle": "Serves 4 · mostly hands-off"
        },
        "blocks": [
          {
            "kind": "numbers",
            "items": [
              {
                "value": "60 min",
                "label": "Total time"
              },
              {
                "value": "4",
                "label": "Serves"
              }
            ]
          },
          {
            "kind": "text",
            "sections": [
              {
                "heading": "Ingredients",
                "bullets": [
                  "1 whole chicken, about 1.5 kg",
                  "2 cups jasmine rice",
                  "6 cloves garlic, 5 slices ginger",
                  "2 pandan leaves",
                  "Chilli, lime, dark soy to serve"
                ]
              },
              {
                "heading": "Method",
                "paragraphs": [
                  "1. Poach the chicken in gently simmering water with ginger for 35 minutes, then plunge it into ice water.",
                  "2. Fry the rice with garlic and a spoon of chicken fat, then cook it in the poaching stock with pandan.",
                  "3. Slice the chicken and serve with the rice, chilli and dark soy."
                ]
              }
            ]
          }
        ],
        "details": {
          "assumptions": [
            "Based on a standard home method; adjust salt to taste."
          ]
        },
        "fallback_text": "Hainanese chicken rice for 4, about 60 min. You need 1 whole chicken (about 1.5 kg), 2 cups jasmine rice, 6 cloves garlic, 5 slices ginger, 2 pandan leaves, and chilli, lime and dark soy to serve. 1. Poach the chicken with the ginger for 35 min, then plunge it into ice water. 2. Fry the rice with garlic and a spoon of chicken fat, then cook it in the stock with pandan. 3. Slice and serve with the rice, chilli and dark soy."
      },
