{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weave.cloud/contracts/output-blocks/v1",
  "title": "Harso output blocks v1 (PROPOSED DRAFT, not in registry)",
  "$comment": "PROPOSAL ONLY. Agent-authored structured result. The agent chooses and orders blocks; the app owns all styling, inline-vs-page, and live state. Plain text only (no markdown, no HTML). Numbers are decimal strings so the document stays inside the conversation JCS subset (safe integers only; contracts.py conversation_jcs). Rules a JSON Schema cannot express (one visual, action last, pick uniqueness, status binding, series/cell arity, 16384-byte canonical bound) live in the semantic validator, as in tools/contracts.py. Keywords are restricted to the set tools/mobile_schema_codegen.py already compiles to Swift/TypeScript; new patterns need adding to FROZEN_PATTERNS.",
  "oneOf": [
    {
      "$ref": "#/$defs/document"
    }
  ],
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifact_uri": {
      "type": "string",
      "maxLength": 45,
      "pattern": "^artifact:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "https_url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:/[^\\s]*)?$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,6})?$"
    },
    "latitude": {
      "type": "string",
      "minLength": 1,
      "maxLength": 11,
      "pattern": "^-?[0-9]{1,2}(\\.[0-9]{1,7})?$"
    },
    "longitude": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^-?[0-9]{1,3}(\\.[0-9]{1,7})?$"
    },
    "line12": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line16": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line24": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line28": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line40": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line48": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line60": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line80": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line200": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line280": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "line600": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*[^\\s\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069][^\\u0000-\\u001F\\u007F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "domain": {"type": "string", "minLength": 3, "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"},
    "template_name": {"enum": ["bills-due", "compare-products", "day-agenda", "deadlines-from-mail", "delivery-tracking", "flight-options", "flight-status", "inbox-brief", "meeting-brief", "places-nearby", "price-watch", "product-shortlist", "recurring-reminder", "reply-draft", "reply-watch", "research-brief", "stock-quote", "subscriptions", "trip-itinerary", "weather-now"]},
    "utc_minute": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z$"},
    "date_only": {"type": "string", "minLength": 10, "maxLength": 10},
    "airport_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "calendar_color": {"enum": ["blue", "green", "orange", "red", "purple", "gray"]},
    "weather_condition": {"enum": ["clear", "night", "partly", "cloudy", "rain", "storm"]},
    "flight_facts": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "number": {"$ref": "#/$defs/line12"}, "origin_code": {"$ref": "#/$defs/airport_code"}, "destination_code": {"$ref": "#/$defs/airport_code"}, "origin_name": {"$ref": "#/$defs/line48"}, "destination_name": {"$ref": "#/$defs/line48"},
        "scheduled_departure": {"$ref": "#/$defs/line16"}, "departure": {"$ref": "#/$defs/line16"}, "arrival": {"$ref": "#/$defs/line16"}, "departure_zone": {"$ref": "#/$defs/line12"}, "arrival_zone": {"$ref": "#/$defs/line12"},
        "terminal": {"$ref": "#/$defs/line12"}, "gate": {"$ref": "#/$defs/line12"}, "previous_gate": {"$ref": "#/$defs/line12"}, "boarding": {"$ref": "#/$defs/line16"}, "seat": {"$ref": "#/$defs/line12"}, "remaining": {"$ref": "#/$defs/line24"}
      }
    },
    "row_flight": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "number": {"$ref": "#/$defs/line12"}, "origin_code": {"$ref": "#/$defs/airport_code"}, "destination_code": {"$ref": "#/$defs/airport_code"}, "origin_name": {"$ref": "#/$defs/line48"}, "destination_name": {"$ref": "#/$defs/line48"},
        "scheduled_departure": {"$ref": "#/$defs/line16"}, "departure": {"$ref": "#/$defs/line16"}, "arrival": {"$ref": "#/$defs/line16"}, "departure_zone": {"$ref": "#/$defs/line12"}, "arrival_zone": {"$ref": "#/$defs/line12"},
        "terminal": {"$ref": "#/$defs/line12"}, "gate": {"$ref": "#/$defs/line12"}, "previous_gate": {"$ref": "#/$defs/line12"}, "boarding": {"$ref": "#/$defs/line16"}, "seat": {"$ref": "#/$defs/line12"}, "remaining": {"$ref": "#/$defs/line24"},
        "arrival_day_offset": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "weather_hour": {
      "type": "object", "additionalProperties": false,
      "properties": {"condition": {"$ref": "#/$defs/weather_condition"}, "rain": {"type": "integer", "minimum": 0, "maximum": 100}}
    },
    "weather_day": {
      "type": "object", "additionalProperties": false, "required": ["label", "condition", "low", "high"],
      "properties": {"label": {"$ref": "#/$defs/line16"}, "condition": {"$ref": "#/$defs/weather_condition"}, "low": {"$ref": "#/$defs/decimal"}, "high": {"$ref": "#/$defs/decimal"}}
    },
    "weather": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "sky": {"enum": ["clear-day", "clear-night", "cloudy", "rain", "storm"]},
        "current_condition": {"$ref": "#/$defs/weather_condition"},
        "high": {"$ref": "#/$defs/decimal"}, "low": {"$ref": "#/$defs/decimal"},
        "hourly": {"type": "array", "minItems": 1, "maxItems": 31, "items": {"$ref": "#/$defs/weather_hour"}},
        "days": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/weather_day"}}
      }
    },
    "state": {
      "enum": [
        "working",
        "needs_you",
        "ready",
        "needs_attention",
        "stopped_by_you",
        "failed",
        "watching",
        "scheduled",
        "empty",
        "tracking"
      ]
    },
    "row_status": {
      "enum": [
        "overdue",
        "paid",
        "done",
        "in_progress",
        "needs_you",
        "problem"
      ]
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/line60"
        },
        "subtitle": {
          "$ref": "#/$defs/line80"
        },
        "brand": {"$ref": "#/$defs/domain"}
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "lat",
        "lon"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/line40"
        },
        "lat": {
          "$ref": "#/$defs/latitude"
        },
        "lon": {
          "$ref": "#/$defs/longitude"
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "places"
      ],
      "properties": {
        "kind": {
          "const": "map"
        },
        "places": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/place"
          }
        },
        "selected_place_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "credit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/line40"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "alt"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact_uri"
        },
        "alt": {
          "$ref": "#/$defs/line200"
        },
        "credit": {
          "$ref": "#/$defs/credit"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "alt"
      ],
      "properties": {
        "kind": {
          "const": "image"
        },
        "artifact": {
          "$ref": "#/$defs/artifact_uri"
        },
        "alt": {
          "$ref": "#/$defs/line200"
        },
        "aspect": {
          "enum": [
            "square",
            "4:3",
            "16:9",
            "3:4"
          ]
        },
        "images": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/photo"
          }
        },
        "credit": {
          "$ref": "#/$defs/credit"
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "alt"
      ],
      "properties": {
        "kind": {
          "const": "video"
        },
        "artifact": {
          "$ref": "#/$defs/artifact_uri"
        },
        "alt": {
          "$ref": "#/$defs/line200"
        },
        "poster": {
          "$ref": "#/$defs/artifact_uri"
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "values"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/line24"
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 31,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/decimal"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "chart",
        "x_labels",
        "series"
      ],
      "properties": {
        "kind": {
          "const": "chart"
        },
        "chart": {
          "enum": [
            "bar",
            "line",
            "donut",
            "scatter"
          ]
        },
        "unit": {
          "$ref": "#/$defs/line12"
        },
        "x_labels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 31,
          "items": {
            "$ref": "#/$defs/line16"
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/series"
          }
        },
        "highlight_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "range": {"enum": ["1D", "1W", "1M", "1Y"]},
        "baseline": {"$ref": "#/$defs/decimal"}
      }
    },
    "visual_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "visual"
      ],
      "properties": {
        "kind": {
          "const": "visual"
        },
        "visual": {
          "oneOf": [
            {
              "$ref": "#/$defs/map"
            },
            {
              "$ref": "#/$defs/image"
            },
            {
              "$ref": "#/$defs/video"
            },
            {
              "$ref": "#/$defs/chart"
            }
          ]
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/line48"
        },
        "secondary": {
          "$ref": "#/$defs/line80"
        },
        "trailing": {
          "$ref": "#/$defs/line24"
        },
        "mark": {
          "const": "pick"
        },
        "status": {
          "$ref": "#/$defs/row_status"
        },
        "status_label": {
          "$ref": "#/$defs/line16"
        },
        "group": {
          "$ref": "#/$defs/line24"
        },
        "thumbnail": {
          "$ref": "#/$defs/photo"
        },
        "brand": {"$ref": "#/$defs/domain"},
        "action": {"$ref": "#/$defs/action_open_url"},
        "rating": {"$ref": "#/$defs/decimal"},
        "review_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "noise_db": {"$ref": "#/$defs/decimal"},
        "category": {"$ref": "#/$defs/line48"},
        "opening_label": {"$ref": "#/$defs/line80"},
        "open_state": {"enum": ["open", "closed", "unknown"]},
        "distance": {"$ref": "#/$defs/line24"},
        "travel_mode": {"enum": ["walk", "drive", "transit", "cycle"]},
        "unread": {"type": "boolean"},
        "due_at": {"$ref": "#/$defs/utc_minute"},
        "starts_at": {"$ref": "#/$defs/utc_minute"},
        "calendar_color": {"$ref": "#/$defs/calendar_color"},
        "flight": {"$ref": "#/$defs/row_flight"}
      }
    },
    "rows_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "rows"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "total_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/line12"
        },
        "label": {
          "$ref": "#/$defs/line24"
        },
        "delta": {
          "$ref": "#/$defs/line16"
        }
      }
    },
    "numbers_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "numbers"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/number"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {
          "$ref": "#/$defs/line60"
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/line600"
          }
        },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/line200"
          }
        },
        "date": {"$ref": "#/$defs/date_only"},
        "thumbnail": {"$ref": "#/$defs/photo"}
      }
    },
    "text_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sections"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "summary": {
          "$ref": "#/$defs/line280"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/line24"
        },
        "align": {
          "enum": [
            "start",
            "end"
          ]
        },
        "thumbnail": {"$ref": "#/$defs/photo"}
      }
    },
    "table_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells"
      ],
      "properties": {
        "cells": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/line40"
          }
        },
        "status": {
          "$ref": "#/$defs/row_status"
        },
        "status_label": {
          "$ref": "#/$defs/line16"
        },
        "winner": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "table_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "columns",
        "rows"
      ],
      "properties": {
        "kind": {
